CSV_FILE_PATH=large_sales_data.csv
LLM_ENDPOINT=http://localhost:8080/v1/chat/completions
LLM_API_FORMAT=openai

# Set to true to enable Presidio PII detection and anonymization.
SANITIZE_PII=false
SENSITIVE_COLUMNS=customer_name,credit_card,ssn
PRESIDIO_LANGUAGE=en

MAX_CONTEXT_TOKENS=128000
CHUNK_MAX_TOKENS=30000
MAX_LLM_OUTPUT_TOKENS=1024
TOKEN_ESTIMATE_CHARS_PER_TOKEN=4
REQUEST_TIMEOUT_SECONDS=120

ANALYSIS_GOAL=Identify top revenue categories, average order values, and notable outliers.
# Supported map placeholders: {goal_prompt}, {chunk}, {chunk_number}, {chunk_count}
MAP_PROMPT_TEMPLATE="<start_of_turn>user\nYou are a data analysis assistant.\nPerform the following task on this dataset subset: {goal_prompt}\nData:\n{chunk}\nProvide structured metrics, key trends, and numerical insights.<end_of_turn>\n<start_of_turn>model\n"
# Supported reduce placeholders: {goal_prompt}, {combined_summaries}, {chunk_count}
REDUCE_PROMPT_TEMPLATE="<start_of_turn>user\nYou are a lead data scientist.\nBelow are regional summaries of a larger dataset. Combine these insights into a single unified executive summary for the overall goal: {goal_prompt}\n\nIntermediate Summaries:\n{combined_summaries}<end_of_turn>\n<start_of_turn>model\n"
